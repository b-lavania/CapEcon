{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capecon.local/ontology/shared/economics.schema.json",
  "title": "Economics",
  "type": "object",
  "properties": {
    "primary_metric_usd": { "type": "number" },
    "primary_metric_label": { "type": "string" },
    "primary_metric_display": { "type": "string" },
    "currency": { "type": "string", "default": "USD" },
    "breakdown": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "amount_usd"],
        "properties": {
          "label": { "type": "string" },
          "amount_usd": { "type": "number" },
          "notes": { "type": "string" }
        }
      }
    },
    "pricing_mode": {
      "type": "string",
      "enum": ["internal_budget", "product_sku", "marketplace_take"]
    },
    "floor_usd": { "type": ["number", "null"] },
    "risk_usd": { "type": ["number", "null"] },
    "cost_basis": {
      "type": "string",
      "enum": ["metered", "allocated", "estimated", "simulated"]
    },
    "charged_basis": {
      "type": "string",
      "enum": ["invoiced", "reconstructed"]
    },
    "attributed_pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "cap_usd": { "type": ["number", "null"] },
    "list_usd": { "type": ["number", "null"] },
    "list_basis": {
      "type": "string",
      "enum": ["contracted", "implied"]
    },
    "charged_usd": { "type": ["number", "null"] },
    "baseline_usd": { "type": ["number", "null"] },
    "margin_usd": { "type": ["number", "null"] },
    "ranking_metric_usd": { "type": "number" },
    "ranking_metric_label": { "type": "string" },
    "n_verified": { "type": "integer", "minimum": 0 },
    "value_usd": { "type": ["number", "null"] },
    "value_basis": {
      "type": "string",
      "enum": ["observed", "estimated", "prior"]
    },
    "value_breakdown": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "amount_usd"],
        "properties": {
          "label": { "type": "string" },
          "amount_usd": { "type": "number" },
          "notes": { "type": "string" }
        }
      }
    },
    "surplus_usd": { "type": ["number", "null"] },
    "tier_list_usd": { "type": ["number", "null"] },
    "wtp_evidence": { "type": "object" },
    "verification_cost_usd": { "type": ["number", "null"] },
    "agency_surplus_usd": { "type": ["number", "null"] },
    "token_mopt": {
      "type": ["number", "null"],
      "description": "Marginal outcome probability per 1k tokens"
    }
  }
}
