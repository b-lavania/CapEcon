{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capecon.local/ontology/shared/growth_decision_record.base.schema.json",
  "title": "GrowthDecisionRecord",
  "description": "Version 2.0 - Added optional standard compliance fields (adp, opendone_receipt, opentrajectory_id). All proprietary features preserved.",
  "type": "object",
  "required": [
    "record_id",
    "vertical",
    "schema_version",
    "evaluated_at",
    "subject",
    "exceptions",
    "decision"
  ],
  "properties": {
    "record_id": { "type": "string" },
    "vertical": {
      "type": "string",
      "enum": ["capability_lifecycle", "agent_runtime", "orchestration", "eval_governance", "marketplace_commerce", "clinical_runtime"]
    },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "ontology_version": { "type": "string" },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "evaluator_id": { "type": "string" },
    "subject": {
      "type": "object",
      "properties": {
        "entity_type": {
          "type": "string",
          "enum": ["account", "capability", "seller", "workflow"]
        },
        "workspace_id": { "type": "string" },
        "account_id": { "type": "string" },
        "capability_id": { "type": "string" },
        "capability_version": { "type": "string" },
        "agent_id": { "type": "string" },
        "connector_id": { "type": "string" },
        "cohort_id": { "type": "string" },
        "experiment_id": { "type": "string" },
        "seller_id": { "type": "string" },
        "assist_type": { "type": "string" }
      },
      "anyOf": [
        { "required": ["account_id"] },
        { "required": ["capability_id"] },
        { "required": ["seller_id"] }
      ]
    },
    "exceptions": {
      "type": "array",
      "items": { "$ref": "exception_item.schema.json" }
    },
    "economics": { "$ref": "economics.schema.json" },
    "decision": { "$ref": "decision.schema.json" },
    "evidence": {
      "type": "object",
      "properties": {
        "claim_type": { "type": "string", "enum": ["associational", "causal", "simulated"] },
        "caption": { "type": "string" },
        "n": { "type": "integer", "minimum": 0 }
      }
    },
    "outcome": {
      "type": "object",
      "properties": {
        "retention_delta_14d": { "type": "number" },
        "retention_delta_28d": { "type": "number" },
        "churn_happened": { "type": "boolean" },
        "actual_run_cost_usd": { "type": "number" }
      }
    },
    "adp": {
      "type": "object",
      "description": "OPTIONAL ADP (Agent Decision Protocol) compliance metadata. Added in v2.0 for regulatory interoperability. NOT a replacement for CapEcon's triage system.",
      "properties": {
        "autonomy_level": {
          "type": "string",
          "enum": ["A1", "A2", "A3", "A4", "A5"],
          "description": "ADP autonomy level (A1=no autonomy, A5=full autonomy)"
        },
        "decision_type": {
          "type": "string",
          "enum": ["operational", "strategic", "financial", "regulatory"],
          "description": "ADP decision type classification"
        },
        "risk_level": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "description": "ADP risk level classification"
        },
        "classification_code": {
          "type": "string",
          "description": "ADP classification code (e.g., operational-medium)"
        },
        "authorization": {
          "type": "object",
          "properties": {
            "result": {
              "type": "string",
              "enum": ["auto_approved", "approval_required", "denied"]
            },
            "reason": { "type": "string" }
          }
        }
      }
    },
    "opendone_receipt": {
      "type": "object",
      "description": "OPTIONAL OpenDone receipt for external verification. Added in v2.0 for interoperability. NOT a replacement for CapEcon's Outcome Definition Kit.",
      "properties": {
        "passed": { "type": "boolean" },
        "criteriaResults": { "type": "array" },
        "constraintResults": { "type": "array" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "opentrajectory_id": {
      "type": "string",
      "description": "OPTIONAL OpenTrajectory export ID. Added in v2.0 for interoperability. NOT a replacement for CapEcon's internal classification."
    }
  }
}
